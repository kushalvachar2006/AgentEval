{
  "name": "agenteval",
  "version": "0.6.0",
  "private": true,
  "description": "AgentEval - AI Agent Quality Engineering Platform (monorepo root; each app has its own package.json)",
  "scripts": {
    "init:env": "node scripts/init-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:engine": "node scripts/run-engine.mjs",
    "dev:worker": "npm --prefix apps/api run worker",
    "dev:web": "npm --prefix apps/web run dev",
    "test": "node scripts/verify.mjs",
    "test:api": "npm --prefix apps/api test",
    "test:python": "node scripts/verify.mjs --python-only"
  },
  "engines": {
    "node": ">=20"
  }
}
