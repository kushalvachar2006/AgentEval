# Example: your OWN nginx terminating TLS in front of AgentEval (instead of the bundled Caddy).
# Point it at the website container (publish it with WEB_BIND=127.0.0.1 WEB_PORT=8080 in .env).
# Set TRUST_PROXY=1 (already the default in docker-compose.yml) so client IPs / rate limits are correct behind one proxy hop.
server {
  listen 80;
  server_name agenteval.example.com;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl http2;
  server_name agenteval.example.com;
  ssl_certificate     /etc/letsencrypt/live/agenteval.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/agenteval.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  client_max_body_size 6m;
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
