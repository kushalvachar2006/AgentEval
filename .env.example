# Copy to .env with:  npm run init:env   (it fills every {{...}} with a fresh random secret)
# Never commit .env.

NODE_ENV=development
WEB_PORT=8080
API_PORT=4000

# --- MongoDB credentials (used by Docker Compose) ---
MONGO_ROOT_USER=agenteval
MONGO_ROOT_PASSWORD={{MONGO_ROOT_PASSWORD}}

# --- Evaluation engine (shared secret between the worker and the engine) ---
ENGINE_TOKEN={{ENGINE_TOKEN}}
ENGINE_URL=http://127.0.0.1:8000

# --- App secrets ---
JWT_SECRET={{JWT_SECRET}}
ENCRYPTION_KEY={{ENCRYPTION_KEY}}

# --- Connection string used when you run the API on your own machine (npm run dev:api).
#     Inside Docker Compose this is overridden automatically to use the service name. ---
MONGODB_URI=mongodb://agenteval:{{MONGO_ROOT_PASSWORD}}@localhost:27017/agenteval?authSource=admin

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Optional tuning (defaults shown) ---
# TRACE_RETENTION_DAYS=90          # traces are deleted automatically after this many days
# ALLOW_PRIVATE_ENDPOINTS=false    # true = agents may use private/localhost endpoint URLs (self-hosted only; disables the SSRF network check)
# AUTH_RATE_LIMIT_MAX=10           # failed logins/registrations allowed per 15 minutes per IP
# INGEST_RATE_LIMIT_MAX=600        # trace uploads per minute per API key
# MAX_TRACE_BYTES=4194304          # largest single trace stored (after redaction/truncation)
# WORKER_CONCURRENCY=2            # evaluation cases processed in parallel
# MAX_CASES_PER_RUN=500            # largest test suite one run may evaluate
# DEFAULT_MAX_JUDGE_CALLS=200      # AI-judge calls allowed per run unless the run sets its own limit
# SDK_RUN_WAIT_MINUTES=30          # how long an SDK-driven run waits for your agent's traces
# AGENT_CALL_TIMEOUT_MS=60000      # per-call timeout when AgentEval calls your agent's HTTP endpoint
# --- Milestone 5 (live monitoring and alerts), all optional ---
# PUBLIC_WEB_URL=http://localhost:8080   # lets webhook messages link back to the website
# ALERT_TICK_MS=15000                    # how often a worker looks for due alert rules
# PROD_EVAL_MAX_AGE_HOURS=24             # sampled traces older than this are skipped if the worker was far behind
# MAX_ALERT_RULES=100                    # alert rules per organization
# ROLLUP_RETENTION_DAYS=400              # hourly rollups kept this long
# ALERT_RETENTION_DAYS=365               # fired alerts kept this long

# --- Milestone 6 (accounts, sessions, production), all optional ---
# ALLOW_REGISTRATION=true          # false = only the first account can sign up; everyone else joins by invitation (recommended for team installs)
# JWT_TTL_SECONDS=900              # access token lifetime (the refresh token renews it silently)
# REFRESH_TTL_DAYS=30              # how long a device stays signed in without activity
# LOGIN_MAX_FAILURES=5             # wrong passwords per account before it is locked ...
# LOGIN_WINDOW_MINUTES=15          # ... within this window
# LOGIN_LOCK_MINUTES=15            # how long the lock lasts
# INVITE_TTL_DAYS=7                # invitation links expire after this
# RESET_TTL_MINUTES=60             # admin-issued password-reset links expire after this
# --- Production with HTTPS (docker-compose.prod.yml) ---
# DOMAIN=agenteval.example.com
# ACME_EMAIL=you@example.com
# WEB_BIND=127.0.0.1               # use 0.0.0.0 only if you are NOT using the bundled Caddy and have your own firewall

